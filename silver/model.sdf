<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="silver">
    <link name="base_link">
      <inertial>
        <pose>0.003475127956175234 -4.592282392876946e-05 -0.03000743571259557 0.0 -0.0 0.0</pose>
        <mass>2.218387890479499</mass>
        <inertia>
          <ixx>0.02525515075706975</ixx>
          <ixy>3.410915038082274e-06</ixy>
          <ixz>-0.0001134885980087065</ixz>
          <iyy>0.02660887307713708</iyy>
          <iyz>3.82914374606966e-06</iyz>
          <izz>0.04177236904136958</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>meshes/base_link__vis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- DarkGrey -->
          <ambient>0.175 0.175 0.175 1.0</ambient>
          <diffuse>0.175 0.175 0.175 1.0</diffuse>
          <specular>0.175 0.175 0.175 1.0</specular>
        </material>
      </visual>
      <collision name="base_link_collision">
        <!-- Box primitivo (era mesh trimesh -> causava ODE trimesh-trimesh overflow).
             Dimensoes/centro = bounding box do antigo base_link__col.stl. -->
        <pose>0.0008 0.0 -0.0761 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4947 0.4948 0.2415</size>
          </box>
        </geometry>
      </collision>
      <sensor name="d435i_depth" type="depth_camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <pose>-0.01565 0.09485 -0.0383 -0.0 -0.0 1.570796</pose>
        <topic>d435i_depth</topic>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="d435i_color" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <pose>-0.03065 0.09485 -0.0383 -0.0 -0.0 1.570796</pose>
        <topic>d435i_color</topic>
        <camera>
          <horizontal_fov>1.396263</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="d435i_infra1" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <pose>0.03435 0.09485 -0.0383 -0.0 -0.0 1.570796</pose>
        <topic>d435i_infra1</topic>
        <camera>
          <horizontal_fov>1.396263</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format> <!-- D435i infra: escala de cinza -->

          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="d435i_imu" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <pose>0.01355 0.08285 -0.0332 -0.0 -0.0 1.570796</pose>
        <topic>d435i_imu</topic>
        <imu />
      </sensor>
      <sensor name="d435i_infra2" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <pose>-0.01565 0.09485 -0.0373 -0.0 -0.0 1.570796</pose>
        <topic>d435i_infra2</topic>
        <camera>
          <horizontal_fov>1.396263</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format> <!-- D435i infra: escala de cinza -->

          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- ===== Sensores de voo (portados da versao antiga 'silver') ===== -->
      <!-- sensor de pressao -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <!-- imu do controlador de voo -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- sensor nav_sat (desativado na versao antiga) -->
      <!-- <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor> -->

      <!-- magnetometro: o nome deve coincidir com o declarado no GZBridge.cpp,
           senao a PX4 nao consegue fazer a ponte do topico do GZ para a PX4 -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0.000000080</mean>
              <bias_mean>0.000000400</bias_mean>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.000000080</mean>
              <bias_mean>0.000000400</bias_mean>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.000000080</mean>
              <bias_mean>0.000000400</bias_mean>
            </noise>
          </z>
        </magnetometer>
      </sensor>
    </link>
    <link name="rotor_0">
      <inertial>
        <pose>0.12938244905459884 -0.1285842073913007 0.03226998520115751 0.0 -0.0 0.0</pose>
        <mass>0.0066284678023075345</mass>
        <inertia>
          <ixx>6.299485395442131e-06</ixx>
          <ixy>-6.021010365436552e-06</ixy>
          <ixz>-1.708225714133478e-11</ixz>
          <iyy>5.988141719802422e-06</iyy>
          <iyz>-1.8015701028841228e-11</iyz>
          <izz>1.2232017849120986e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>meshes/rotor_0_1__vis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- Vermelho (#B21613) -->
          <ambient>0.694 0.071 0.071 1.0</ambient>
          <diffuse>0.694 0.071 0.071 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="rotor_0_collision">
        <pose>0.1294 -0.1286 0.0316 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1600 0.1563 0.0094</size>
          </box>
        </geometry>
      </collision>
    </link>
    <link name="rotor_1">
      <inertial>
        <pose>-0.12778260224468957 0.12858244898829643 0.03153547606517574 0.0 -0.0 0.0</pose>
        <mass>0.006628467802335466</mass>
        <inertia>
          <ixx>5.994010826522252e-06</ixx>
          <ixy>6.020992175538641e-06</ixy>
          <ixz>-1.1537283173095048e-11</ixz>
          <iyy>6.305354501671712e-06</iyy>
          <iyz>1.3971873828798158e-11</iyz>
          <izz>1.223201807563245e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>meshes/rotor_1_1__vis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- Preto -->
          <ambient>0.01 0.01 0.01 1.0</ambient>
          <diffuse>0.01 0.01 0.01 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <pose>-0.1278 0.1286 0.0317 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1563 0.1600 0.0091</size>
          </box>
        </geometry>
      </collision>
    </link>
    <link name="rotor_2">
      <inertial>
        <pose>0.12938420745769247 0.12858244898820748 0.03226998520115753 0.0 -0.0 0.0</pose>
        <mass>0.006628467802307532</mass>
        <inertia>
          <ixx>5.988141833325328e-06</ixx>
          <ixy>6.02101036543582e-06</ixy>
          <ixz>1.802990210879622e-11</ixz>
          <iyy>6.29948528191772e-06</iyy>
          <iyz>-1.7096458231454165e-11</iyz>
          <izz>1.2232017849119468e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>meshes/rotor_2_1__vis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- Vermelho (#B21613) -->
          <ambient>0.694 0.071 0.071 1.0</ambient>
          <diffuse>0.694 0.071 0.071 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="rotor_2_collision">
        <pose>0.1294 0.1286 0.0316 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1564 0.1600 0.0098</size>
          </box>
        </geometry>
      </collision>
    </link>
    <link name="rotor_3">
      <inertial>
        <pose>-0.12778244892190582 -0.12858260231108065 0.03153547606517568 0.0 -0.0 0.0</pose>
        <mass>0.0066284678023354636</mass>
        <inertia>
          <ixx>6.305354388852724e-06</ixx>
          <ixy>-6.02099217553879e-06</ixy>
          <ixz>-1.395799599694463e-11</ixz>
          <iyy>5.994010939341051e-06</iyy>
          <iyz>-1.1551161038829893e-11</iyz>
          <izz>1.2232018075632504e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>meshes/rotor_3_1__vis.stl</uri>
          </mesh>
        </geometry>
        <material> <!-- Preto -->
          <ambient>0.01 0.01 0.01 1.0</ambient>
          <diffuse>0.01 0.01 0.01 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
      <collision name="rotor_3_collision">
        <pose>-0.1277 -0.1286 0.0318 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1603 0.1563 0.0104</size>
          </box>
        </geometry>
      </collision>
    </link>
    <joint name="rotor_1_joint" type="continuous">
      <pose relative_to="__model__">-0.12778339418017343 0.12858339418017328 0.02729999999999981 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz expressed_in="__model__">2.4694738632952357e-16 -2.1138969806591227e-16 -1.0</xyz>
      </axis>
    </joint>
    <joint name="rotor_3_joint" type="continuous">
      <pose relative_to="__model__">-0.12778339418017354 -0.12858339418017314 0.027299999999999755 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz expressed_in="__model__">1.251311863034323e-15 -4.4630592655269164e-17 -1.0</xyz>
      </axis>
    </joint>
    <joint name="rotor_2_joint" type="continuous">
      <pose relative_to="__model__">0.12938339418017317 0.1285833941801732 0.02729999999999986 0.0 -0.0 0.0</pose>
      <parent>base_link</parent>
      <child>rotor_2</child>
