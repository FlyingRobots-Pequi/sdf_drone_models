<?xml version="1.0" ?>
<sdf version="1.10">
    <model name="hermit">
        <link name="base_link">
          <inertial>
            <pose>0.012074452623654553 -0.000290936055994153 -0.03217120836100611 0.0 -0.0 0.0</pose>
            <mass>1.9351014774256954</mass>
            <inertia>
              <ixx>0.010003826998556216</ixx>
              <ixy>1.8055243573532933e-06</ixy>
              <ixz>4.321980401955412e-05</ixz>
              <iyy>0.012023955778993926</iyy>
              <iyz>4.7346027188299e-05</iyz>
              <izz>0.011437588209398155</izz>
            </inertia>
          </inertial>
          <visual name="base_link_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/base_link__vis.stl</uri>
              </mesh>
            </geometry>

            <material> <!-- DarkGrey-->
          			<ambient>0.175 0.175 0.175 1.0</ambient>
          			<diffuse>0.175 0.175 0.175 1.0</diffuse>
          			<specular>0.175 0.175 0.175 1.0</specular>
        		</material>
          </visual>
          <collision name="base_link_collision">
            <!-- Box that bounds base_link__col.stl (5429 tris). A primitive is used
                 instead of the trimesh to avoid the ODE trimesh-trimesh contact
                 hash-table overflow; the detailed mesh is kept only for the visual. -->
            <pose>-0.0013 -0.0013 -0.028 0 0 0</pose>
            <geometry>
              <box>
                <size>0.3909 0.3909 0.4067</size>
              </box>
            </geometry>
          </collision>

          <!-- sensor de pressao -->
          <sensor name="air_pressure_sensor" type="air_pressure">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <air_pressure>
              <pressure>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </pressure>
            </air_pressure>
          </sensor>

          <!-- adicao de imu -->
          <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>250</update_rate>
            <imu>
              <angular_velocity>
                <x>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00018665</stddev>
                    <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
                  </noise>
                </x>
                <y>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00018665</stddev>
                    <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
                  </noise>
                </y>
                <z>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00018665</stddev>
                    <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
                  </noise>
                </z>
              </angular_velocity>
              <linear_acceleration>
                <x>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00186</stddev>
                    <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
                  </noise>
                </x>
                <y>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00186</stddev>
                    <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
                  </noise>
                </y>
                <z>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00186</stddev>
                    <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
                  </noise>
                </z>
              </linear_acceleration>
            </imu>
          </sensor>

          <!-- sensor nav_sat -->
          <!-- <sensor name="navsat_sensor" type="navsat">
            <always_on>1</always_on>
            <update_rate>30</update_rate>
          </sensor> -->

          <!-- magnetometro -->
          <!-- nesse caso, o nome do magnetometro deve coincidir com o que foi declarado na linha 224 do GZBridge.cpp. Caso contrario, a px4 nao consegue fazer a ponte do topico do GZ para a PX4 -->
          <!-- stddev > 0 e' OBRIGATORIO: sem ruido o valor publicado e' bit-identico
               a cada amostra com o drone parado, e o DataValidator do PX4 declara
               "MAG #0 failed: STALE" (ERROR_FLAG_STALE_DATA = mesmo valor N vezes
               seguidas, tolerancia 1e-6). Unidade: a mesma do field_tesla publicado
               (magnitude ~0.48 neste world, escala de Gauss); 0.005 ~ 5 mG, na ordem
               do sensor_mag_sim do PX4 (0.02-0.03 G). -->
          <sensor name="magnetometer_sensor" type="magnetometer">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <magnetometer>
              <x>
                <noise type="gaussian">
                  <mean>0.000000080</mean>
                  <stddev>0.005</stddev>
                  <bias_mean>0.000000400</bias_mean>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.000000080</mean>
                  <stddev>0.005</stddev>
                  <bias_mean>0.000000400</bias_mean>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.000000080</mean>
                  <stddev>0.005</stddev>
                  <bias_mean>0.000000400</bias_mean>
                </noise>
              </z>
            </magnetometer>
          </sensor>
        </link>
        <link name="rotor_0">
          <inertial>
            <pose>0.1763844206792035 -0.17637943648886864 0.06337746866140588 0.0 -0.0 0.0</pose>
            <mass>0.012598461511382962</mass>
            <inertia>
              <ixx>3.710697522772412e-05</ixx>
              <ixy>4.749301291262628e-07</ixy>
              <ixz>8.185499993746889e-12</ixz>
              <iyy>3.607522739863529e-07</iyy>
              <iyz>1.9567636747042094e-10</iyz>
              <izz>3.731524850791629e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_0_1_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_0_1__vis.stl</uri>
              </mesh>
            </geometry>

            <material>
              <ambient>0.694 0.071 0.071 1.0</ambient> <!-- Vermelho (#B21613) -->
              <diffuse>0.694 0.071 0.071 1.0</diffuse>
              <specular>0.5 0.5 0.5 1.0</specular>
            </material>
          </visual>
          <collision name="rotor_0_1_collision">
            <!-- Box identical to rotor_0_1__col.stl (the STL is itself a 12-tri box);
                 a primitive avoids ODE trimesh-trimesh contacts. -->
            <pose>0.176385 -0.176385 0.06258 0 0 0</pose>
            <geometry>
              <box>
                <size>0.0293 0.2543 0.0114</size>
              </box>
            </geometry>
          </collision>
        </link>
        <link name="rotor_1">
          <inertial>
            <pose>-0.17638511126513406 0.17639009545546488 0.06337746866140771 0.0 -0.0 0.0</pose>
            <mass>0.012598461511382828</mass>
            <inertia>
              <ixx>3.710697522368422e-05</ixx>
              <ixy>4.749301269754225e-07</ixy>
              <ixz>-1.5835377822383256e-11</ixz>
              <iyy>3.6075227372484335e-07</iyy>
              <iyz>2.1969724517813087e-10</iyz>
              <izz>3.7315248503614934e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_1_1_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_1_1__vis.stl</uri>
              </mesh>
            </geometry>

            <material>
              <ambient>0.01 0.01 0.01 1.0</ambient> <!-- Preto -->
              <diffuse>0.01 0.01 0.01 1.0</diffuse>
              <specular>0.5 0.5 0.5 1.0</specular>
            </material>
          </visual>
          <collision name="rotor_1_1_collision">
            <!-- Box identical to rotor_1_1__col.stl (the STL is itself a 12-tri box);
                 a primitive avoids ODE trimesh-trimesh contacts. -->
            <pose>-0.176385 0.176385 0.06258 0 0 0</pose>
            <geometry>
              <box>
                <size>0.0293 0.2543 0.0114</size>
              </box>
            </geometry>
          </collision>
        </link>
        <link name="rotor_2">
          <inertial>
            <pose>0.17638442067917215 0.17637943648922266 0.0633774686613781 0.0 -0.0 0.0</pose>
            <mass>0.012598461511437403</mass>
            <inertia>
              <ixx>3.7106975227556554e-05</ixx>
              <ixy>-4.749301290980193e-07</ixy>
              <ixz>8.185498448758793e-12</ixz>
              <iyy>3.607522735197123e-07</iyy>
              <iyz>-1.9567635730602558e-10</iyz>
              <izz>3.7315248507741624e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_2_1_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_2_1__vis.stl</uri>
              </mesh>
            </geometry>

            <material>
              <ambient>0.694 0.071 0.071 1.0</ambient> <!-- Vermelho (#B21613) -->
              <diffuse>0.694 0.071 0.071 1.0</diffuse>
              <specular>0.5 0.5 0.5 1.0</specular>
            </material>
          </visual>
          <collision name="rotor_2_1_collision">
            <!-- Box identical to rotor_2_1__col.stl (the STL is itself a 12-tri box);
                 a primitive avoids ODE trimesh-trimesh contacts. -->
            <pose>0.176385 0.176385 0.06258 0 0 0</pose>
            <geometry>
              <box>
                <size>0.0293 0.2543 0.0114</size>
              </box>
            </geometry>
          </collision>
        </link>
        <link name="rotor_3">
          <inertial>
            <pose>-0.17638511126516174 -0.17639009545511752 0.063377468661378 0.0 -0.0 0.0</pose>
            <mass>0.012598461511437448</mass>
            <inertia>
              <ixx>3.710697522351698e-05</ixx>
              <ixy>-4.7493012694712483e-07</ixy>
              <ixz>-1.5835379367371352e-11</ixz>
              <iyy>3.607522732579859e-07</iyy>
              <iyz>-2.196972350679456e-10</iyz>
              <izz>3.731524850344016e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_3_1_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_3_1__vis.stl</uri>
              </mesh>
            </geometry>

            <material>
              <ambient>0.01 0.01 0.01 1.0</ambient> <!-- Preto -->
              <diffuse>0.01 0.01 0.01 1.0</diffuse>
              <specular>0.5 0.5 0.5 1.0</specular>
            </material>
          </visual>
          <collision name="rotor_3_1_collision">
            <!-- Box identical to rotor_3_1__col.stl (the STL is itself a 12-tri box);
                 a primitive avoids ODE trimesh-trimesh contacts. -->
            <pose>-0.176385 -0.176385 0.06258 0 0 0</pose>
            <geometry>
              <box>
                <size>0.0293 0.2543 0.0114</size>
              </box>
            </geometry>
          </collision>
        </link>
        <!-- Juntas dos rotores: "continuous" NAO e' suportado pelo DART (gz
             Garden) — vira joint FIXO silenciosamente e o MulticopterMotorModel
             nunca aplica empuxo (helice parada, drone nao voa). Usar revolute
             com limites +-1e16, como no x500 do PX4. -->
        <joint name="rotor_0_joint" type="revolute">
          <pose relative_to="__model__">0.17638475093013944 -0.17638475093013636 0.05729999999999826 0.0 -0.0 0.0</pose>
          <parent>base_link</parent>
          <child>rotor_0</child>
          <axis>
            <xyz expressed_in="__model__">1.3844322706171756e-16 -2.26332997379012e-16 1.000000000000001</xyz>
            <limit>
              <lower>-1e+16</lower>
              <upper>1e+16</upper>
            </limit>
          </axis>
        </joint>
        <joint name="rotor_1_joint" type="revolute">
          <pose relative_to="__model__">-0.1763847509301365 0.17638475093013736 0.057300000000000066 0.0 -0.0 0.0</pose>
          <parent>base_link</parent>
          <child>rotor_1</child>
          <axis>
            <xyz expressed_in="__model__">-5.825324369117805e-16 -2.1775621247104748e-16 1.000000000000001</xyz>
            <limit>
              <lower>-1e+16</lower>
              <upper>1e+16</upper>
            </limit>
          </axis>
        </joint>
        <joint name="rotor_2_joint" type="revolute">
          <pose relative_to="__model__">0.1763847509301355 0.17638475093014036 0.057299999999998324 0.0 -0.0 0.0</pose>
          <parent>base_link</parent>
          <child>rotor_2</child>
          <axis>
            <xyz expressed_in="__model__">-2.177562124710515e-16 1.3844322706171766e-16 1.000000000000001</xyz>
            <limit>
              <lower>-1e+16</lower>
              <upper>1e+16</upper>
            </limit>
          </axis>
        </joint>
        <joint name="rotor_3_joint" type="revolute">
          <pose relative_to="__model__">-0.17638475093013656 -0.1763847509301394 0.0572999999999982 0.0 -0.0 0.0</pose>
          <parent>base_link</parent>
          <child>rotor_3</child>
          <axis>
            <xyz expressed_in="__model__">-2.263329973790141e-16 -5.825324369117797e-16 1.000000000000001</xyz>
            <limit>
              <lower>-1e+16</lower>
              <upper>1e+16</upper>
            </limit>
          </axis>
        </joint>

        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <jointName>rotor_0_joint</jointName>
            <linkName>rotor_0</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>1000.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>command/motor_speed</commandSubTopic>
            <motorNumber>0</motorNumber>
            <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
            <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <jointName>rotor_1_joint</jointName>
            <linkName>rotor_1</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>1000.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>command/motor_speed</commandSubTopic>
            <motorNumber>1</motorNumber>
            <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
            <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <jointName>rotor_2_joint</jointName>
            <linkName>rotor_2</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>1000.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>command/motor_speed</commandSubTopic>
            <motorNumber>2</motorNumber>
            <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
            <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
            <jointName>rotor_3_joint</jointName>
            <linkName>rotor_3</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.025</timeConstantDown>
            <maxRotVelocity>1000.0</maxRotVelocity>
            <motorConstant>8.54858e-06</motorConstant>
            <momentConstant>0.016</momentConstant>
            <commandSubTopic>command/motor_speed</commandSubTopic>
            <motorNumber>3</motorNumber>
            <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
            <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>

        <!-- camera realsense T265 -->
        <include merge='true'>
            <uri>model://realsense_t265</uri>
            <pose>0.1125 0.020 0.013 -1.5707963267948966 3.141592653589793 1.5707963267948966</pose>
        </include>
        <joint name="CameraJoint" type="fixed">
            <parent>base_link</parent>
            <child>realsense_t265/base</child>
            <pose relative_to="base_link">0.1125 0.020 0.013 -1.5707963267948966 3.141592653589793 1.5707963267948966</pose>
        </joint>

        <!-- camera realsense D455 -->
        <include merge="true">
            <uri>model://realsense_d455</uri>
            <pose>0.129227 0 -0.0507 0 1.5707963267948966 0</pose>
        </include>
        <joint name="CameraJointD455" type="fixed">
            <parent>base_link</parent>
            <child>realsense_d455/base</child>
            <pose relative_to="base_link">0.129227 0 -0.0507 0 1.5707963267948966 0</pose>
        </joint>

        <!-- ===================== LiDAR 2D tipo RPLIDAR A2 ===================== -->
        <link name="lidar_mount_link">
            <pose>0 0 0.09 0 0 0</pose> <!-- ajuste a altura se necessário -->
            <inertial>
                <pose>0 0 0 0 0 0</pose>
                <mass>0.15</mass>
                <inertia>
                    <ixx>0.0002</ixx>
                    <iyy>0.0002</iyy>
                    <izz>0.0002</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>

            <collision name="lidar_mount_collision">
                <geometry>
                    <box>
                        <size>0.09 0.09 0.04</size> <!-- 9x9x4 cm -->
                    </box>
                </geometry>
            </collision>

            <visual name="lidar_mount_visual">
                <geometry>
                    <box>
                        <size>0.09 0.09 0.04</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.15 0.15 0.15 1</ambient>
                    <diffuse>0.15 0.15 0.15 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>

            <visual name="lidar_top_visual">
                <pose>0 0 0.025 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.042</radius>
                        <length>0.012</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.02 0.02 0.02 1</ambient>
                    <diffuse>0.02 0.02 0.02 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular>
                </material>
            </visual>

            <!-- Sensor LiDAR 2D (Ignition / gz-sim) -->
            <sensor name="rplidar_a2" type="gpu_lidar">
                <always_on>1</always_on>
                <update_rate>10</update_rate>
                <pose>0 0 0.03 0 0 0</pose>
                <topic>/scan</topic> <!-- LaserScan em /scan (+ /scan/points) -->
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>1600</samples> <!-- ~0.225° -->
                            <resolution>1</resolution>
                            <min_angle>-3.1415926535</min_angle>
                            <max_angle>3.1415926535</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.2</min>
                        <max>12.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </link>

        <joint name="lidar_mount_joint" type="fixed">
            <parent>base_link</parent>
            <child>lidar_mount_link</child>
            <pose>0 0 0 0 0 0</pose>
        </joint>
        <!-- ===================== FIM LiDAR ===================== -->
    </model>
</sdf>