<?xml version="1.0" ?>
<sdf version="1.10">
    <model name="hermit">
        <link name="base_link">
          <inertial>
            <pose>0.012074452623654553 -0.000290936055994153 -0.03217120836100611 0.0 -0.0 0.0</pose>
            <mass>1.9351014774256954</mass>
            <inertia>
              <ixx>0.010003826998556216</ixx>
              <ixy>1.8055243573532933e-06</ixy>
              <ixz>4.321980401955412e-05</ixz>
              <iyy>0.012023955778993926</iyy>
              <iyz>4.7346027188299e-05</iyz>
              <izz>0.011437588209398155</izz>
            </inertia>
          </inertial>
          <visual name="base_link_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/base_link__vis.stl</uri>
              </mesh>
            </geometry>

            <material> <!-- DarkGrey-->
          			<ambient>0.175 0.175 0.175 1.0</ambient>
          			<diffuse>0.175 0.175 0.175 1.0</diffuse>
          			<specular>0.175 0.175 0.175 1.0</specular>
        		</material>
          </visual>
          <collision name="base_link_collision">
            <!-- Box that bounds base_link__col.stl (5429 tris). A primitive is used
                 instead of the trimesh to avoid the ODE trimesh-trimesh contact
                 hash-table overflow; the detailed mesh is kept only for the visual. -->
            <pose>-0.0013 -0.0013 -0.028 0 0 0</pose>
            <geometry>
              <box>
                <size>0.3909 0.3909 0.4067</size>
              </box>
            </geometry>
          </collision>

          <!-- sensor de pressao -->
          <sensor name="air_pressure_sensor" type="air_pressure">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <air_pressure>
              <pressure>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </pressure>
            </air_pressure>
          </sensor>

          <!-- adicao de imu -->
          <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>250</update_rate>
            <imu>
              <angular_velocity>
                <x>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00018665</stddev>
                    <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
                  </noise>
                </x>
                <y>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00018665</stddev>
                    <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
                  </noise>
                </y>
                <z>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00018665</stddev>
                    <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
                  </noise>
                </z>
              </angular_velocity>
              <linear_acceleration>
                <x>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00186</stddev>
                    <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
                  </noise>
                </x>
                <y>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00186</stddev>
                    <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
                  </noise>
                </y>
                <z>
                  <noise type="gaussian">
                    <mean>0</mean>
                    <stddev>0.00186</stddev>
                    <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                    <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
                  </noise>
                </z>
              </linear_acceleration>
            </imu>
          </sensor>

          <!-- sensor nav_sat -->
          <!-- <sensor name="navsat_sensor" type="navsat">
            <always_on>1</always_on>
            <update_rate>30</update_rate>
          </sensor> -->

          <!-- magnetometro -->
          <!-- nesse caso, o nome do magnetometro deve coincidir com o que foi declarado na linha 224 do GZBridge.cpp. Caso contrario, a px4 nao consegue fazer a ponte do topico do GZ para a PX4 -->
          <sensor name="magnetometer_sensor" type="magnetometer">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <magnetometer>
              <x>
                <noise type="gaussian">
                  <mean>0.000000080</mean>
                  <bias_mean>0.000000400</bias_mean>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.000000080</mean>
                  <bias_mean>0.000000400</bias_mean>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.000000080</mean>
                  <bias_mean>0.000000400</bias_mean>
                </noise>
              </z>
            </magnetometer>
          </sensor>
        </link>
        <link name="rotor_0">
          <inertial>
            <pose>0.1763844206792035 -0.17637943648886864 0.06337746866140588 0.0 -0.0 0.0</pose>
            <mass>0.012598461511382962</mass>
            <inertia>
              <ixx>3.710697522772412e-05</ixx>
              <ixy>4.749301291262628e-07</ixy>
              <ixz>8.185499993746889e-12</ixz>
              <iyy>3.607522739863529e-07</iyy>
              <iyz>1.9567636747042094e-10</iyz>
              <izz>3.731524850791629e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_0_1_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_0_1__vis.stl</uri>
              </mesh>
            </geometry>

            <material>
              <ambient>0.694 0.071 0.071 1.0</ambient> <!-- Vermelho (#B21613) -->
              <diffuse>0.694 0.071 0.071 1.0</diffuse>
              <specular>0.5 0.5 0.5 1.0</specular>
            </material>
          </visual>
          <collision name="rotor_0_1_collision">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_0_1__col.stl</uri>
              </mesh>
            </geometry>
          </collision>
        </link>
        <link name="rotor_1">
          <inertial>
            <pose>-0.17638511126513406 0.17639009545546488 0.06337746866140771 0.0 -0.0 0.0</pose>
            <mass>0.012598461511382828</mass>
            <inertia>
              <ixx>3.710697522368422e-05</ixx>
              <ixy>4.749301269754225e-07</ixy>
              <ixz>-1.5835377822383256e-11</ixz>
              <iyy>3.6075227372484335e-07</iyy>
              <iyz>2.1969724517813087e-10</iyz>
              <izz>3.7315248503614934e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_1_1_visual">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_1_1__vis.stl</uri>
              </mesh>
            </geometry>

            <material>
              <ambient>0.01 0.01 0.01 1.0</ambient> <!-- Preto -->
              <diffuse>0.01 0.01 0.01 1.0</diffuse>
              <specular>0.5 0.5 0.5 1.0</specular>
            </material>
          </visual>
          <collision name="rotor_1_1_collision">
            <geometry>
              <mesh>
                <scale>0.001 0.001 0.001</scale>
                <uri>meshes/rotor_1_1__col.stl</uri>
              </mesh>
            </geometry>
          </collision>
        </link>
        <link name="rotor_2">
          <inertial>
            <pose>0.17638442067917215 0.17637943648922266 0.0633774686613781 0.0 -0.0 0.0</pose>
            <mass>0.012598461511437403</mass>
            <inertia>
              <ixx>3.7106975227556554e-05</ixx>
              <ixy>-4.749301290980193e-07</ixy>
              <ixz>8.185498448758793e-12</ixz>
              <iyy>3.607522735197123e-07</iyy>
              <iyz>-1.9567635730602558e-10</iyz>
              <izz>3.7315248507741624e-05</izz>
            </inertia>
          </inertial>
          <visual name="rotor_2_1_visual">
            <geometry>
